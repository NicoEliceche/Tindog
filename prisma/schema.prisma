// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String                   @id @default(cuid())
  email                      String                   @unique
  name                       String?
  avatarUrl                  String?
  googleSub                  String?                  @unique

  // Zona aproximada, para poder decir "esta a 8 km" sin saber donde vive.
  //
  // Se guarda ya redondeada a dos decimales, que a esta latitud es una celda
  // de unos 900 x 1100 metros: alcanza para filtrar por radio y no para dar
  // con una direccion. El redondeo se hace antes de guardar, no al mostrar:
  // si entrara el dato fino, ya estaria en la base y ahi es donde importa
  // que no este. Es la misma promesa que hace el perfil, que muestra la zona
  // general y nunca el domicilio.
  zoneLat                    Float?
  zoneLng                    Float?
  // Nombre legible de la zona, el que el usuario escribe en su perfil.
  zoneLabel                  String?
  zoneUpdatedAt              DateTime?

  authAccounts               AuthAccount[]
  sessions                   AuthSession[]
  pets                       Pet[]                    @relation("PetOriginalOwner")
  petCaregiverships          PetCaregiver[]
  conversations              Conversation[]
  messages                   Message[]
  sentConnectionRequests     ConnectionRequest[]      @relation("ConnectionRequestSender")
  receivedConnectionRequests ConnectionRequest[]      @relation("ConnectionRequestReceiver")
  appointmentParticipants    AppointmentParticipant[]
  safeLocationReviews        SafeLocationReview[]
  safetyCheckIns             SafetyCheckIn[]
  pushDevices                PushDevice[]
  settings                   UserSettings?
  blocksCreated              UserBlock[]              @relation("BlockCreator")
  blocksReceived             UserBlock[]              @relation("BlockedUser")
  reportsCreated             Report[]                 @relation("ReportCreator")
  reportsReceived            Report[]                 @relation("ReportedUser")
  mediaAssets                MediaAsset[]
  moderationCases            ModerationCase[]         @relation("ModerationSubject")
  moderationAppeals          ModerationAppeal[]
  pushJobs                   PushJob[]
  dataExportJobs             DataExportJob[]
  deletionRequest            AccountDeletionRequest?
  role                       String                   @default("user")
  status                     String                   @default("active")
  deletionScheduledAt        DateTime?
  deletedAt                  DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
}

model AuthAccount {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model AuthSession {
  id               String    @id @default(cuid())
  tokenHash        String    @unique
  platform         String    @default("web")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  stepUpVerifiedAt DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId, platform])
}

model Pet {
  id                 String   @id @default(cuid())
  // ... rest of fields
  name               String
  breed              String
  gender             String
  age                Int
  weight             Float?
  bio                String?
  photos             String[]
  personality_traits String[]
  has_papers         Boolean  @default(false)
  paper_types        String[]
  is_competitor      Boolean  @default(false)

  // La pertenencia vive en PetCaregiver: una mascota puede estar a cargo de
  // varias personas -pareja, familia, un cuidador- y cada una necesita verla
  // y coordinar sus citas. `ownerId` queda como el titular original, para
  // saber quien la dio de alta y a quien atribuir la cuenta.
  owner                   User                     @relation("PetOriginalOwner", fields: [ownerId], references: [id])
  ownerId                 String
  caregivers              PetCaregiver[]
  competitions            Competition[]
  healthRecords           HealthRecord[]
  breedingPrefs           BreedingPreference?
  connectionRequests      ConnectionRequest[]
  appointmentParticipants AppointmentParticipant[]
  mediaAssets             MediaAsset[]

  fatherId              String?
  motherId              String?
  paternalGrandfatherId String?
  paternalGrandmotherId String?
  maternalGrandfatherId String?
  maternalGrandmotherId String?

  coiPercentage        Float?
  isVerifiedBreederPet Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Conversation {
  id                String              @id @default(cuid())
  users             User[]
  messages          Message[]
  agreements        BreedingAgreement[]
  connectionRequest ConnectionRequest?
  appointments      Appointment[]
  reports           Report[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model BreedingAgreement {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  conversationId String
  creatorId      String
  terms          String
  status         String
  pet1Id         String
  pet2Id         String
  appointment    Appointment?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Appointment {
  id             String                   @id @default(cuid())
  agreement      BreedingAgreement?       @relation(fields: [agreementId], references: [id], onDelete: Restrict)
  agreementId    String?                  @unique
  conversation   Conversation?            @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  conversationId String?
  petIds         String[]
  ownerIds       String[]
  location       Location                 @relation(fields: [locationId], references: [id])
  locationId     String
  datetime       DateTime
  endAt          DateTime?
  status         String // 'scheduled', 'completed', 'cancelled'
  notes          String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  participants   AppointmentParticipant[]
  reviews        SafeLocationReview[]
  safetyCheckIns SafetyCheckIn[]

  @@index([conversationId, status])
  @@index([datetime, status])
}

model Location {
  id           String               @id @default(cuid())
  name         String
  address      String
  placeId      String
  type         String // 'park', 'cafe', 'pet_store'
  lat          Float
  lng          Float
  appointments Appointment[]
  reviews      SafeLocationReview[]
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([placeId])
}

model Message {
  id               String       @id @default(cuid())
  text             String
  sender           User         @relation(fields: [senderId], references: [id])
  senderId         String
  conversation     Conversation @relation(fields: [conversationId], references: [id])
  conversationId   String
  kind             String       @default("text")
  readAt           DateTime?
  deletedAt        DateTime?
  moderationStatus String       @default("approved")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([conversationId, createdAt])
}

model ConnectionRequest {
  id             String        @id @default(cuid())
  sender         User          @relation("ConnectionRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  receiver       User          @relation("ConnectionRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId     String
  pet            Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  petId          String
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  conversationId String?       @unique
  status         String        @default("pending")
  createdAt      DateTime      @default(now())
  respondedAt    DateTime?

  @@index([receiverId, status, createdAt])
  @@index([senderId, status, createdAt])
}

model AppointmentParticipant {
  id            String      @id @default(cuid())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  pet           Pet?        @relation(fields: [petId], references: [id], onDelete: SetNull)
  petId         String?

  @@unique([appointmentId, userId])
  @@index([userId])
}

model SafeLocationReview {
  id                 String      @id @default(cuid())
  location           Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId         String
  appointment        Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId      String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String
  rating             Int
  comment            String
  verifiedAttendance Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([appointmentId, userId])
  @@index([locationId, createdAt])
}

model SafetyCheckIn {
  id            String      @id @default(cuid())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  checkedInAt   DateTime?
  checkedOutAt  DateTime?
  status        String      @default("pending")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([appointmentId, userId])
}

model UserSettings {
  id                  String   @id @default(cuid())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String   @unique
  themeMode           String   @default("dark")
  discoveryEnabled    Boolean  @default(true)
  showDistance        Boolean  @default(true)
  maxDistanceKm       Int      @default(25)
  showOnlineStatus    Boolean  @default(false)
  readReceipts        Boolean  @default(true)
  healthVisibility    String   @default("connections")
  safetyCheckIns      Boolean  @default(true)
  lostPetAlerts       Boolean  @default(true)
  pushMessages        Boolean  @default(true)
  pushRequests        Boolean  @default(true)
  pushAppointments    Boolean  @default(true)
  notificationPreview String   @default("generic")
  updatedAt           DateTime @updatedAt
}

model PushDevice {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  platform   String
  token      String    @unique
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId, platform, revokedAt])
}

model UserBlock {
  id        String   @id @default(cuid())
  blocker   User     @relation("BlockCreator", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id             String          @id @default(cuid())
  reporter       User            @relation("ReportCreator", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId     String
  reportedUser   User?           @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reportedUserId String?
  conversation   Conversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  conversationId String?
  category       String
  detail         String
  status         String          @default("open")
  priority       String          @default("normal")
  legalHoldUntil DateTime?
  moderationCase ModerationCase?
  createdAt      DateTime        @default(now())
  resolvedAt     DateTime?

  @@index([status, createdAt])
  @@index([reportedUserId, createdAt])
}

model MediaAsset {
  id               String    @id @default(cuid())
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId          String
  pet              Pet?      @relation(fields: [petId], references: [id], onDelete: Cascade)
  petId            String?
  purpose          String
  status           String    @default("awaiting_upload")
  quarantineKey    String    @unique
  processedKey     String?   @unique
  publicUrl        String?
  declaredMime     String
  detectedMime     String?
  declaredSize     Int
  observedSize     Int?
  checksumSha256   String
  width            Int?
  height           Int?
  moderationLabels String[]
  rejectionReason  String?
  retentionUntil   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([ownerId, status, createdAt])
  @@index([retentionUntil, status])
}

model ModerationCase {
  id                String             @id @default(cuid())
  subjectUser       User?              @relation("ModerationSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  subjectUserId     String?
  report            Report?            @relation(fields: [reportId], references: [id], onDelete: SetNull)
  reportId          String?            @unique
  targetType        String
  targetId          String?
  source            String
  status            String             @default("open")
  severity          String             @default("medium")
  categories        String[]
  evidence          Json?
  provider          String?
  providerVersion   String?
  automatedDecision String?
  legalHoldUntil    DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  appeals           ModerationAppeal[]

  @@index([status, severity, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([targetType, targetId])
}

model ModerationAppeal {
  id               String         @id @default(cuid())
  moderationCase   ModerationCase @relation(fields: [moderationCaseId], references: [id], onDelete: Cascade)
  moderationCaseId String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  reason           String
  status           String         @default("pending")
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([moderationCaseId, userId])
  @@index([status, createdAt])
}

model PushJob {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  category  String
  payload   Json
  status    String    @default("pending")
  attempts  Int       @default(0)
  notBefore DateTime  @default(now())
  lockedAt  DateTime?
  sentAt    DateTime?
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, notBefore, createdAt])
  @@index([userId, status])
}

model DataExportJob {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  status      String    @default("pending")
  objectKey   String?   @unique
  expiresAt   DateTime?
  completedAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status, createdAt])
  @@index([expiresAt, status])
}

model AccountDeletionRequest {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String    @unique
  status      String    @default("scheduled")
  scheduledAt DateTime
  requestedAt DateTime  @default(now())
  cancelledAt DateTime?
  completedAt DateTime?
  reason      String?
  updatedAt   DateTime  @updatedAt

  @@index([status, scheduledAt])
}

model SecurityAuditEvent {
  id            String   @id @default(cuid())
  occurredAt    DateTime @default(now())
  actorUserId   String?
  sessionId     String?
  action        String
  outcome       String
  targetType    String?
  targetId      String?
  requestId     String?
  ipHash        String?
  userAgentHash String?
  metadata      Json?
  eventHash     String   @unique

  @@index([occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, outcome, occurredAt])
}

/**
 * Personas a cargo de una mascota. Es la relacion N-N entre User y Pet.
 *
 * `role` distingue quien puede que cosa: el titular edita y da de baja, un
 * cuidador coordina citas mientras dura el encargo. `until` deja caducar ese
 * acceso solo, sin que nadie tenga que acordarse de quitarlo.
 */
model PetCaregiver {
  id     String @id @default(cuid())
  pet    Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)
  petId  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /** owner | co_owner | caregiver */
  role      String    @default("caregiver")
  invitedBy String?
  until     DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Una persona aparece una sola vez por mascota.
  @@unique([petId, userId])
  // Listar las mascotas de alguien, que es la consulta de cada pantalla.
  @@index([userId, role])
  @@index([petId, role])
}

model Competition {
  id    String  @id @default(cuid())
  name  String
  year  Int
  award String?
  pet   Pet     @relation(fields: [petId], references: [id])
  petId String
}

model BreedingPreference {
  id               String  @id @default(cuid())
  looking_for_pair Boolean @default(false)
  terms            String?
  last_heat_cycle  String?
  pet              Pet     @relation(fields: [petId], references: [id])
  petId            String  @unique
}

model HealthRecord {
  id        String @id @default(cuid())
  test_name String
  result    String
  date      String
  pet       Pet    @relation(fields: [petId], references: [id])
  petId     String
}
