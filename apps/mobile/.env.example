# Use your Render URL, or your PC LAN IP when testing with a development build on a phone.
# Example for local testing: EXPO_PUBLIC_API_URL="http://192.168.1.25:3000"
EXPO_PUBLIC_API_URL="https://your-render-service.onrender.com"

# Google Sign-In native requires a development build. It will not work in Expo Go.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID="your-android-client-id.apps.googleusercontent.com"
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID="your-ios-client-id.apps.googleusercontent.com"

# Native map keys are embedded in each binary; restrict by Android package/SHA-1 and iOS bundle ID.
GOOGLE_MAPS_ANDROID_API_KEY="your-android-restricted-maps-key"
GOOGLE_MAPS_IOS_API_KEY="your-ios-restricted-maps-key"
