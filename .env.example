# Pooled Neon connection for runtime queries.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/tindog?sslmode=require"

# Direct Neon connection for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/tindog?sslmode=require"

# Generate at least 32 cryptographically random bytes; never reuse between environments.
JWT_SECRET="replace-with-at-least-32-random-bytes"
AUDIT_HASH_SECRET="replace-with-a-different-32-byte-random-secret"

GOOGLE_WEB_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"
GOOGLE_ANDROID_CLIENT_ID="your-android-client-id.apps.googleusercontent.com"
GOOGLE_IOS_CLIENT_ID="your-ios-client-id.apps.googleusercontent.com"

# Server-only Places key. Restrict to Places API (New) and the production server IP/workload.
GOOGLE_PLACES_API_KEY="your-server-places-key"

# Distributed, atomic rate limiting. Required in production.
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Private S3-compatible quarantine/export storage and processed-media bucket.
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
OBJECT_STORAGE_FORCE_PATH_STYLE="false"
OBJECT_STORAGE_ACCESS_KEY_ID="your-storage-access-key"
OBJECT_STORAGE_SECRET_ACCESS_KEY="your-storage-secret-key"
OBJECT_STORAGE_QUARANTINE_BUCKET="tindog-quarantine"
OBJECT_STORAGE_PROCESSED_BUCKET="tindog-media"
OBJECT_STORAGE_EXPORT_BUCKET="tindog-private-exports"
OBJECT_STORAGE_SSE_ALGORITHM="AES256"
MEDIA_PUBLIC_BASE_URL="https://media.tindog.app"

# Private malware and moderation providers. Evidence key: openssl rand -base64 32
MALWARE_SCANNER_URL="https://scanner.internal.example/v1/scan"
MALWARE_SCANNER_TOKEN="replace-with-scanner-token"
MODERATION_API_URL="https://moderation.internal.example/v1/moderate"
MODERATION_API_TOKEN="replace-with-moderation-token"
MODERATION_EVIDENCE_KEY="replace-with-base64-encoded-32-byte-key"

# Separate immutable log/alert sinks and internal worker/admin access.
SECURITY_LOG_SINK_URL="https://security-logs.example/v1/events"
SECURITY_LOG_SINK_TOKEN="replace-with-log-sink-token"
SECURITY_ALERT_WEBHOOK_URL="https://security-alerts.example/v1/urgent"
SECURITY_ALERT_WEBHOOK_TOKEN="replace-with-alert-token"
WORKER_SECRET="replace-with-at-least-32-random-bytes"
ADMIN_API_ACCESS_KEY="replace-with-at-least-32-random-bytes"
TINDOG_INTERNAL_API_URL="https://tindog-api-1d18.onrender.com"

# Optional browser Maps Embed key. It is public by design; restrict by HTTPS referrer and API.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY="your-referrer-restricted-embed-key"

# Comma-separated origins allowed to call the auth API from browsers.
CORS_ORIGIN="http://localhost:3000,https://nicoeliceche.github.io"

# Web frontend config. GitHub Pages uses /Tindog as base path and Render as API.
NEXT_PUBLIC_API_BASE_URL="https://tindog-api-1d18.onrender.com"
NEXT_PUBLIC_WEB_ORIGIN="https://nicoeliceche.github.io"
NEXT_PUBLIC_DEPLOY_TARGET=""
NEXT_PUBLIC_BASE_PATH=""
