DATABASE_URL="postgresql://USER:PASSWORD@HOST/tindog?sslmode=require"
JWT_SECRET="replace-with-a-long-random-string"

GOOGLE_WEB_CLIENT_ID="your-web-client-id.apps.googleusercontent.com"
GOOGLE_ANDROID_CLIENT_ID="your-android-client-id.apps.googleusercontent.com"
GOOGLE_IOS_CLIENT_ID="your-ios-client-id.apps.googleusercontent.com"

# Comma-separated origins allowed to call the auth API from browsers.
CORS_ORIGIN="http://localhost:3000"

# Optional when the web frontend is served separately from the API.
NEXT_PUBLIC_API_BASE_URL=""
NEXT_PUBLIC_WEB_ORIGIN="http://localhost:3000"
